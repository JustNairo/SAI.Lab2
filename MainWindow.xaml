<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="1" >
            <DockPanel DockPanel.Dock="Top">
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="RestartBtn" DockPanel.Dock="Right"
                        Margin="5"
                        Width="40"
                        Content="R"
                        Click="RestartBtn_Click"
                        IsEnabled="False"/>
                    <Button x:Name="GetNewScheduleBtn" 
                    Height="40" Content="Schedule" Margin="5"
                    Click="GetNewScheduleBtn_Click" />
                </DockPanel>

                <Button x:Name="AnalyzeBtn" DockPanel.Dock="Bottom"
                        Margin="5" Height="30"
                        Content="Анализ расписания"
                        Visibility="Collapsed"
                        Click="AnalyzeBtn_Click"/>
            </DockPanel>

            <ScrollViewer x:Name="RightScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                          >
                <StackPanel x:Name="tasksPannel" Margin="5">

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <StackPanel x:Name="schedulePannel" Margin="5,20,5,0">

        </StackPanel>

        <StackPanel x:Name="testPannel" Margin="5,20,5,0">
            <Border Height="120" Background="#ef9bfa" Margin="0, 160, 0, 5" CornerRadius="3">
                <Label Content="Важная встреча (1,5ч)"/>
            </Border>
            <Border Height="80" Background="#bbf28f" Margin="0, 275, 0, 5" CornerRadius="3">
                <Label Content="Совещание (1ч)"/>
            </Border>
        </StackPanel>

        <StackPanel Margin="5,20,5,0">
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="09:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="10:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="11:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="12:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="13:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="14:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="15:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="16:00" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Border>
        </StackPanel>



    </Grid>
</Window>
