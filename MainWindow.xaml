<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="1" >
            <Button x:Name="GetNewSchedule" 
                    Height="40" Content="Schedule" Margin="5" 
                    Click="GetNewSchedule_Click"
                    DockPanel.Dock="Top"/>
            <ScrollViewer x:Name="RightScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                          >
                <StackPanel x:Name="tasksPannel" Margin="5">

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <StackPanel x:Name="schedulePannel" Margin="5,20,5,0">

        </StackPanel>

        <StackPanel Margin="5,20,5,0">
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="01:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="02:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="03:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="04:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="05:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="06:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="07:00" VerticalAlignment="Bottom"/>
            </Border>
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Height="80">
                <TextBlock Text="08:00" VerticalAlignment="Bottom"/>
            </Border>
        </StackPanel>



    </Grid>
</Window>
